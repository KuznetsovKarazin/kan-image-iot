 for(int k=0;k<m->n;k++){const Layer*l=&m->layers[k];
  for(int o=0;o<l->no;o++){float acc=RF(l->b,o);for(int j=0;j<l->ni;j++)acc+=a[j]*RF(l->w,o*l->ni+j);b[o]=(k+1<m->n&&acc<0)?0:acc;}
  memcpy(a,b,l->no*sizeof(float));}
 memcpy(y,a,2*sizeof(float));return 0;
}
int mlp_int8(int id,const float*x,int8_t*qout,float*y){
 if(id<0||id>=3){return -1;}
 const Model*m=&models[id];int8_t a[32],b[32];
 for(int j=0;j<m->layers[0].ni;j++){if(!isfinite(x[j]))return -2;a[j]=(int8_t)roundf(fminf(127.f,fmaxf(-127.f,x[j]/m->input_scale)));}
 for(int k=0;k<m->n;k++){const Layer*l=&m->layers[k];
  for(int o=0;o<l->no;o++){int32_t acc=RI(l->qb,o);for(int j=0;j<l->ni;j++)acc+=(int32_t)a[j]*RQ(l->qw,o*l->ni+j);
   int64_t p=(int64_t)acc*RI(l->mult,o);uint8_t sh=RU(l->shift,o);int64_t mag=((p<0?-p:p)+((int64_t)1<<(sh-1)))>>sh;
   int64_t q=p<0?-mag:mag;if(q>127)q=127;if(q< -127)q=-127;if(k+1<m->n&&q<0)q=0;b[o]=(int8_t)q;}
  memcpy(a,b,l->no);}
 for(int j=0;j<2;j++){qout[j]=a[j];y[j]=a[j]*m->output_scale;}return 0;
}
